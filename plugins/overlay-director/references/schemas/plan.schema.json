{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "overlay-director plan.json",
  "type": "object",
  "required": ["video", "mode", "type", "moments", "variety_score", "top3_move_share"],
  "properties": {
    "video": {
      "type": "object",
      "required": ["source_path", "duration_s"],
      "properties": {
        "source_path": { "type": "string", "description": "absolute realpath, read-only" },
        "scratch_path": { "type": "string" },
        "duration_s": { "type": "number" },
        "fps": { "type": "number" }
      }
    },
    "mode": { "enum": ["MVP", "Standard", "Cinematic"] },
    "type": { "enum": ["tutorial", "ad", "talking-head"] },
    "client_facing": { "type": "boolean", "default": false },
    "moments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "t_start", "t_end", "anchor_text", "move_id", "move_type", "version", "copy", "copy_provenance", "placement", "timing", "density_tier", "hero"],
        "properties": {
          "id": { "type": "string" },
          "t_start": { "type": "number" },
          "t_end": { "type": "number" },
          "anchor_text": { "type": "string" },
          "move_id": { "type": "string" },
          "move_type": { "type": "string", "description": "grouping for variety (from move frontmatter)" },
          "version": { "type": "integer", "minimum": 1 },
          "copy": { "type": "string" },
          "copy_provenance": { "enum": ["verbatim", "distilled"] },
          "placement": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": { "enum": ["content-area", "frame-center", "inline"] },
              "left": { "type": ["number", "string"] },
              "top": { "type": ["number", "string"] }
            }
          },
          "timing": {
            "type": "object",
            "required": ["data_start", "gsap_beats"],
            "properties": {
              "data_start": { "type": "number", "description": "seconds; includes lead-in" },
              "gsap_beats": { "type": "array", "items": { "type": "number" } }
            }
          },
          "density_tier": { "enum": ["base", "promoted", "hero"] },
          "hero": { "type": "boolean" },
          "asset": {
            "type": "object",
            "properties": {
              "kind": { "enum": ["none", "generated", "placeholder"] },
              "path": { "type": "string" },
              "prompt": { "type": "string" }
            }
          }
        }
      }
    },
    "variety_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "top3_move_share": { "type": "number", "minimum": 0, "maximum": 1, "description": "specific-move (move_id) concentration — reported metric" },
    "top3_type_share": { "type": "number", "minimum": 0, "maximum": 1, "description": "family (move_type) concentration — calcification is judged on this" },
    "max_concurrent": { "type": "integer", "minimum": 0, "description": "most overlays live at once (legibility guard)" }
  }
}
