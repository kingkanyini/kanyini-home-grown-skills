# ============================================================
# Morning Compass — Coach Integration Map
# ============================================================
# Coach: <your-username> (<your-name>)
# Created: 2026-05-06 (Phase 2 Task 14.6)
#
# Maps each role required by the brief to the actual provider used.
# Adding a new coach = copy this file to reference/coaches/{slug}/integrations.yml
# and swap providers. Provider catalog lives at reference/integration-providers.md
# (v1.1 deferred — for now, valid providers are documented inline below).
#
# Field shape per role:
#   role_name:
#     provider: <provider_slug>
#     auth: <how_credential_is_held>
#     fetch_via: <tool_call_pattern>
#     notes: <coach-specific tag IDs, calendar IDs, etc>
# ============================================================

coach:
  slug: <your-username>
  display_name: <your-username> (<your-name>)
  voice_profile: <your-username>
  timezone: America/New_York

  # === MORNING-COMPASS MODE (set 2026-05-21 — Phase 1 of inbox-digest pivot) ===
  # Values: full | inbox_only | weekly
  #
  # inbox_only: renders ONLY inbox briefs (Step 0.7) + ENERGY READ + ONE-LINE COMPASS + feedback footer.
  #             Phase 2 (later): IG DMs, YT messages-to-me, Basecamp DMs route INTO inbox-digest as
  #             new comm channels (not as morning-compass roles). When that lands, rename this value
  #             to 'comms_only' and update Step 8 template accordingly.
  #
  # Hypothesis (Cagan): slim inbox-only brief drives ≥80% inbox-brief action-item completion within 24h.
  # Review: 2026-06-04. If <50%, revert to 'full'. If 50-80%, iterate.
  #
  # Measurement protocol (added 2026-05-22 per PM Counsel re-review):
  #   - Next-morning brief asks <your-username>: "Yesterday's inbox items — done / deferred / dropped?"
  #     (3-button inline keyboard, callback_data: completion:done|deferred|dropped:<item_id>)
  #   - Each tap logs one JSONL line to ~/.claude/.morning-compass.completion-log.jsonl with
  #     {ts, item_id, brief_date, decision}
  #   - 2026-06-04 review reads jsonl, computes 14-day rolling completion rate vs <50/50-80/≥80> thresholds.
  #
  # v1.1 multi-coach note (added 2026-05-22 per AI Dev / Thattai):
  #   - This `mode:` field is per-coach. When additional coaches onboard (Britney, Katie, future hires),
  #     each requires (a) own integrations.yml coach block, (b) own cron entry, (c) own vault path
  #     resolution. The mode flag pattern scales; the surrounding single-cron single-hub infrastructure
  #     does not. Revisit when coach #2 is contracted.
  #
  # Roles below stay wired (untouched). Switching mode back to 'full' restores prior behavior in <1 min.
  mode: inbox_only
  # === END MODE ===

  # === BRIEF TAP-THROUGH LINKS (set 2026-05-22 per NSA Counsel re-review) ===
  # Controls whether the inbox brief surfaces clickable URLs to https://briefs.<your-username>.dev/c/<slug>/<date>.
  # FALSE until Phase 4 Cloudflare Access dashboard onboarding completes — see vault note
  # <your-related-note>. Ungated URLs leak client-name routes if the
  # Telegram brief is forwarded or screenshotted. When Cloudflare Access is live, flip to true.
  tap_through_links: false
  # === END TAP-THROUGH ===

roles:

  revenue:
    provider: stripe_direct
    auth: env_restricted_key
    fetch_via: runner_pre_inject
    notes: |
      runner.ps1 calls Stripe REST API with STRIPE_RESTRICTED_KEY (read-only on
      Charges/Invoices/Customers) before spawning headless Claude. Results land in
      runner_inputs.revenue.{7d, prior_7d, open_invoices}. Money never touches Composio.

  calls_booking:
    provider: calendly_composio
    auth: composio_oauth
    fetch_via: composio_mcp
    notes: |
      Composio Calendly tool. All event types pulled. No-show count from
      scheduled_events.status = no_show.

  leads:
    provider: clickfunnels_local
    auth: claude_code_local_mcp
    fetch_via: builtin_cf2_list_contacts
    notes: |
      Built-in cf2_list_contacts tool. Filter created_at > now-7d.

  applications:
    provider: clickfunnels_local
    auth: claude_code_local_mcp
    fetch_via: builtin_cf2_list_contacts
    notes: |
      Built-in cf2_list_contacts tool. Filter contacts.tags includes "application"
      (verify exact tag spelling in CF dashboard before first run).

  project_mgmt:
    provider: basecamp_composio
    auth: composio_oauth
    fetch_via: composio_mcp
    notes: |
      Composio Basecamp tool. QBR detection looks for "queen-bee" or "qbr" tag/prefix.
      Active rocks pulled from todolists named "Rocks" or "Q[N] Rocks".

  calendar:
    provider: google_calendar_local
    fallback_provider: google_calendar_composio
    auth: claude_code_local_mcp
    fetch_via: anthropic_gcal_mcp
    notes: |
      Primary: local Anthropic GCal MCP (faster, no Composio cost).
      Fallback: Composio Google Calendar tool if local MCP unavailable at runtime.

  short_social:
    provider: instagram_composio
    auth: composio_oauth
    fetch_via: composio_mcp
    notes: |
      Composio Instagram tool. Account is Business/Creator type linked to FB Page.
      Comment readiness scoring per the rubric in commands/morning-compass.md.

  long_video:
    provider: youtube_composio
    auth: composio_oauth
    fetch_via: composio_mcp
    notes: |
      Composio YouTube tool with Analytics scope granted at OAuth time.

# ============================================================
# v1.1 backlog (multi-provider per role)
# ============================================================
# When client onboarding kicks in, each of these roles should support multiple
# providers per `reference/integration-providers.md` catalog. Examples:
#   - calls_booking: also support acuity_composio, cal_com, clickfunnels_native
#   - project_mgmt: also support notion_composio, asana_composio, clickup
#   - revenue: also support square_direct, paypal_composio
#   - short_social: also support tiktok_composio, twitter_composio, linkedin_composio
# Each new client = new file at reference/coaches/{slug}/integrations.yml only.
# Skill prompt does not change.
